<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- اختصار: إضافة مصروف سريع -->
    <shortcut
        android:shortcutId="quick_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_expense"
        android:shortcutShortLabel="@string/shortcut_expense_short"
        android:shortcutLongLabel="@string/shortcut_expense_long">
        <intent
            android:action="com.wafra.wafra.QUICK_ADD"
            android:targetPackage="com.wafra.wafra"
            android:targetClass="com.wafra.wafra.MainActivity">
            <extra android:name="type" android:value="expense" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <!-- اختصار: إضافة دخل سريع -->
    <shortcut
        android:shortcutId="quick_income"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_income"
        android:shortcutShortLabel="@string/shortcut_income_short"
        android:shortcutLongLabel="@string/shortcut_income_long">
        <intent
            android:action="com.wafra.wafra.QUICK_ADD"
            android:targetPackage="com.wafra.wafra"
            android:targetClass="com.wafra.wafra.MainActivity">
            <extra android:name="type" android:value="income" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

</shortcuts>
